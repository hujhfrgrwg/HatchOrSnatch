<Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">NextGoal</string><ProtectedString name="Source"><![CDATA[--!strict
-- NextGoal: config-driven "Next goal" pill. An ordered list of rules; the first rule whose goal is
-- not yet met wins. Each rule returns what the pill shows and what a tap does.
-- Put this in ReplicatedStorage next to the shared formula/config modules, so the pill is computed
-- from the same numbers the server enforces.

export type Goal = {
	id: string,
	text: string,          -- "Get 700 Iron for Tier 3"
	have: number?,         -- progress, e.g. 420
	need: number?,         -- e.g. 700 (pill shows "420/700" + bar when both are set)
	ready: boolean?,       -- green READY style
	endsAt: number?,       -- countdown (os.time() seconds) for "Researching Tier 3 2:32"
	action: string,        -- what a tap does: "openResearch", "openWar", "openSell", "pulseProducer"
	arg: any?,             -- e.g. the research node id or the producer kind
}

export type Rule = (state: any, config: any) -> Goal?

local NextGoal = {}

-- Example rules for a tier-gated game (tiers unlock by conquests, resources, cash, then a research);
-- replace them with your game's progression. Each returns a Goal when it is the current blocker, else nil.
-- Order matters: it is the order a player should solve things in.
NextGoal.rules = {
	function(s, cfg): Goal?
		if s.research.active and s.research.active.isTierGate then
			return { id = "researching", text = "Researching Tier " .. s.tier + 1,
				endsAt = s.research.active.endsAt, action = "openResearch" }
		end
		return nil
	end,
	function(s, cfg): Goal?
		local gate = cfg.tiers[s.tier + 1]
		if not gate then return nil end
		local left = gate.conquests - s.conquests
		if left > 0 then
			return { id = "conquer", text = string.format("Conquer %d more", left),
				have = s.conquests, need = gate.conquests, action = "openWar" }
		end
		return nil
	end,
	function(s, cfg): Goal?
		local gate = cfg.tiers[s.tier + 1]
		if not gate then return nil end
		for res, amount in gate.resources do
			local have = s.resources[res] or 0
			if have < amount then
				return { id = "res_" .. res,
					text = string.format("Get %d %s for Tier %d", amount, cfg.names[res], s.tier + 1),
					have = have, need = amount, action = "pulseProducer", arg = res }
			end
		end
		if s.cash < gate.cash then
			return { id = "cash", text = string.format("Save $%d for Tier %d", gate.cash, s.tier + 1),
				have = s.cash, need = gate.cash, action = "openSell" }
		end
		if s.research.active then
			return { id = "labBusy", text = "Lab busy: finishes first",
				endsAt = s.research.active.endsAt, action = "openResearch" }
		end
		return { id = "ready", text = "Research Tier " .. s.tier + 1, ready = true,
			action = "openResearch", arg = gate.researchNode }
	end,
}

function NextGoal.resolve(state: any, config: any): Goal?
	if state.tutorialActive then
		return nil -- the tutorial card is the goal while it runs
	end
	for _, rule in NextGoal.rules do
		local g = rule(state, config)
		if g then return g end
	end
	return nil
end

-- Wire-up sketch (client):
--   local last
--   local function refresh()
--       local g = NextGoal.resolve(State.get(), Config)
--       local key = g and (g.id .. tostring(g.have) .. tostring(g.need)) or ""
--       if key == last then return end      -- update in place only when something changed
--       last = key
--       renderPill(g)                       -- your function: fills GoalText/GoalCount/GoalBar (PATTERNS.md), hides the Goal group when g is nil
--   end
--   State.changed:Connect(refresh)
--   Pill.Activated:Connect(function() local g = NextGoal.resolve(State.get(), Config)
--       if g then Actions[g.action](g.arg) end end)
--   (a separate 1 s loop only re-renders the countdown text when g.endsAt is set)

return NextGoal
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">NumberFormat</string><ProtectedString name="Source"><![CDATA[--!strict
-- NumberFormat: the ONE formatter for every number the player sees (HUD, panels, toasts, billboards).
-- Two formatters in one game disagreed, and the buggy one showed 250,000 as "25K" (it stripped
-- trailing zeros from whole numbers). Use this module everywhere; delete the others.

local NumberFormat = {}

local SUFFIX = { "K", "M", "B", "T", "Qa", "Qi" }

NumberFormat.style = "short" -- "short" (1.36K) or "full" (1,360)

-- Commas: 1234567 -> "1,234,567"
function NumberFormat.full(n: number): string
	n = math.floor(n + 0.5)
	local s = tostring(math.abs(n))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	out = string.gsub(out, "^,", "")
	return (if n < 0 then "-" else "") .. out
end

-- Short: 1234 -> "1.23K", 250000 -> "250K", 1000000 -> "1M".
-- Truncates instead of rounding, so a player with 9,995 never sees "$10K" next to a $10K price.
function NumberFormat.short(n: number): string
	local a = math.abs(n)
	if a < 1000 then
		return NumberFormat.full(n)
	end
	local i = 0
	while a >= 1000 and i < #SUFFIX do
		a /= 1000
		i += 1
	end
	local s
	if a >= 100 then
		s = string.format("%d", math.floor(a))
	elseif a >= 10 then
		s = string.format("%.1f", math.floor(a * 10) / 10)
	else
		s = string.format("%.2f", math.floor(a * 100) / 100)
	end
	-- THE BUG FIX: only strip zeros after a decimal point. "250" must stay "250".
	if string.find(s, ".", 1, true) then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return (if n < 0 then "-" else "") .. s .. SUFFIX[i]
end

function NumberFormat.format(n: number): string
	if NumberFormat.style == "short" then
		return NumberFormat.short(n)
	end
	return NumberFormat.full(n)
end

function NumberFormat.cash(n: number): string
	local s = NumberFormat.format(n)
	if string.sub(s, 1, 1) == "-" then
		return "-$" .. string.sub(s, 2)
	end
	return "$" .. s
end

-- 0.9 -> "0.9/s", 1.35 -> "1.35/s", 12 -> "12/s"
function NumberFormat.rate(perSec: number): string
	if perSec >= 1000 then
		return NumberFormat.short(perSec) .. "/s"
	end
	local s = string.format("%.2f", perSec)
	s = string.gsub(string.gsub(s, "0+$", ""), "%.$", "")
	return s .. "/s"
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function NumberFormat.time(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h, m, s = sec // 3600, (sec // 60) % 60, sec % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Run once in Studio (or from a test runner) after any change.
function NumberFormat._test()
	local cases = {
		{ 0, "0" }, { 999, "999" }, { 1000, "1K" }, { 1234, "1.23K" }, { 99999, "99.9K" },
		{ 100000, "100K" }, { 250000, "250K" }, { 300000, "300K" }, { 999600, "999K" },
		{ 1000000, "1M" }, { 1360000, "1.36M" }, { -2500, "-2.5K" },
	}
	for _, c in cases do
		local got = NumberFormat.short(c[1])
		assert(got == c[2], string.format("short(%s) = %s, want %s", tostring(c[1]), got, c[2]))
	end
	assert(NumberFormat.full(1234567) == "1,234,567")
	assert(NumberFormat.time(75) == "1:15")
	assert(NumberFormat.rate(1.35) == "1.35/s")
	return "NumberFormat ok"
end

return NumberFormat
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">ProgressiveReveal</string><ProtectedString name="Source"><![CDATA[--!strict
-- ProgressiveReveal: the HUD starts as cash + next goal and grows as the player meets each system.
-- ONE function decides visibility from state, so every screen agrees. Pieces that "stay once seen"
-- are remembered in the save (state.revealed), so a returning player isn't re-taught.

local ProgressiveReveal = {}

export type Rule = {
	name: string,              -- HUD element name
	sticky: boolean,           -- true: once shown, stays shown (saved); false: live condition
	when: (state: any) -> boolean,
}

-- Example rules. Replace the conditions with your game's state.
local RULES: { Rule } = {
-- Names are exported element names (name= in build.py). Example HUD: GemsIcon/GemsText, CratesButton, Goal.
	{ name = "GemsIcon", sticky = true, when = function(s) return (s.gems or 0) > 0 end },
	{ name = "GemsText", sticky = true, when = function(s) return (s.gems or 0) > 0 end },
	{ name = "CratesButton", sticky = true, when = function(s) return s.tutorialDone end },
	{ name = "BackpackFull", sticky = false, when = function(s) return s.items >= s.itemCap end },
	{ name = "EventTimer", sticky = false, when = function(s) return s.event ~= nil end },
}
ProgressiveReveal.rules = RULES

-- Returns { [name] = visible } and the list of names newly revealed (to save + celebrate).
function ProgressiveReveal.decide(state: any): ({ [string]: boolean }, { string })
	state.revealed = state.revealed or {}
	local out, newly = {}, {}
	for _, r in ProgressiveReveal.rules do
		local on = r.when(state)
		if r.sticky then
			if on and not state.revealed[r.name] then
				state.revealed[r.name] = true
				table.insert(newly, r.name)
			end
			on = state.revealed[r.name] == true
		end
		out[r.name] = on
	end
	return out, newly
end

-- Apply to a column/row of HUD pieces. Put a UIListLayout in the column so hidden rows
-- close up automatically (Visible=false children take no space in a UIListLayout).
function ProgressiveReveal.apply(hud: Instance, visible: { [string]: boolean })
	for name, on in visible do
		local el = hud:FindFirstChild(name, true) :: GuiObject?
		if el and el.Visible ~= on then
			el.Visible = on
		end
	end
end

return ProgressiveReveal
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">PropertySweep</string><ProtectedString name="Source"><![CDATA[--!strict
-- PropertySweep: objective UI checks for when screenshots can't be trusted (magenta playtest
-- captures, BillboardGuis never captured). Run in the client (playtest) or in edit mode on a cloned
-- ScreenGui. Returns compact lines; parse them locally (a plugin context can't POST anywhere).
--
--   local Sweep = require(path.PropertySweep)
--   print(Sweep.run(PlayerGui.GameUI, { minTap = 48, touch = true }))
--   print(Sweep.atSizes(PlayerGui.GameUI.Root, { Vector2.new(844, 390), Vector2.new(1920, 1080) }, opts))

local PropertySweep = {}

export type Opts = { minTap: number?, touch: boolean?, ignore: { string }? }

local function visible(g: GuiObject): boolean
	local p: Instance? = g
	while p and p:IsA("GuiObject") do
		if not (p :: GuiObject).Visible then return false end
		p = p.Parent
	end
	local sg = g:FindFirstAncestorWhichIsA("LayerCollector")
	return sg == nil or sg.Enabled
end

local function rect(g: GuiObject)
	return g.AbsolutePosition, g.AbsolutePosition + g.AbsoluteSize
end

local function overlaps(a: GuiObject, b: GuiObject): boolean
	local a0, a1 = rect(a)
	local b0, b1 = rect(b)
	local ix = math.min(a1.X, b1.X) - math.max(a0.X, b0.X)
	local iy = math.min(a1.Y, b1.Y) - math.max(a0.Y, b0.Y)
	return ix > 2 and iy > 2 -- 2 px tolerance for touching outlines
end

function PropertySweep.run(root: Instance, opts: Opts?): string
	local o = opts or {}
	local minTap = o.minTap or 48
	local out = {}
	local function add(kind: string, g: Instance, extra: string)
		table.insert(out, kind .. "\t" .. g:GetFullName() .. "\t" .. extra)
	end

	for _, d in root:GetDescendants() do
		if d:IsA("GuiObject") and visible(d) then
			-- text that doesn't fit (TextScaled labels report fit by design; check them by size instead)
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
				if not d.TextFits then
					add("TEXT_NOFIT", d, string.format("%dx%d bounds %dx%d", d.AbsoluteSize.X, d.AbsoluteSize.Y,
						d.TextBounds.X, d.TextBounds.Y))
				end
				if string.find(d.Text, "nil", 1, true) or string.find(d.Text, "?", 1, true)
					or string.find(d.Text, "_%d") then
					add("TEXT_SUSPECT", d, d.Text) -- raw ids, "?" fallbacks, "nil"
				end
			end
			-- tap targets
			if o.touch and d:IsA("GuiButton") then
				local s = d.AbsoluteSize
				if s.X < minTap or s.Y < minTap then
					add("TAP_SMALL", d, string.format("%dx%d < %d", s.X, s.Y, minTap))
				end
			end
			-- child escaping its parent's rect
			local parent = d.Parent
			if parent and parent:IsA("GuiObject") and not parent:IsA("ScrollingFrame") then
				local c0, c1 = rect(d)
				local p0, p1 = rect(parent)
				if c0.X < p0.X - 2 or c0.Y < p0.Y - 2 or c1.X > p1.X + 2 or c1.Y > p1.Y + 2 then
					if parent.ClipsDescendants then add("CLIPPED", d, "cut by parent") end
				end
			end
			-- images: report the asset, not the instance (offscreen instances read IsLoaded=false)
			if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" and not d.IsLoaded then
				add("IMG_NOTLOADED", d, d.Image)
			end
		end
	end

	-- sibling overlap between interactive controls
	for _, d in root:GetDescendants() do
		if d:IsA("GuiObject") then
			local btns = {}
			for _, c in d:GetChildren() do
				if c:IsA("GuiButton") and visible(c) then table.insert(btns, c) end
			end
			for i = 1, #btns do
				for j = i + 1, #btns do
					if overlaps(btns[i], btns[j]) then
						add("OVERLAP", btns[i], btns[j].Name)
					end
				end
			end
		end
	end

	-- billboards (never shown by Studio captures)
	for _, d in root:GetDescendants() do
		if d:IsA("BillboardGui") then
			local a = d.Adornee or d.Parent
			if not d.Enabled or not a or not a.Parent then
				add("BILLBOARD", d, "disabled or no adornee")
			end
		end
	end

	return string.format("%d issues\n%s", #out, table.concat(out, "\n"))
end

-- Sweep several screen sizes without touching the real window: resize the design root and its
-- UIScale the way the runtime controller would, sweep, restore.
function PropertySweep.atSizes(root: Frame, sizes: { Vector2 }, opts: Opts?, designW: number?, designH: number?): string
	local dw, dh = designW or 1920, designH or 1080
	local scale = root:FindFirstChildOfClass("UIScale")
	local oldSize, oldScale = root.Size, scale and scale.Scale
	local report = {}
	for _, v in sizes do
		local f = math.min(v.X / dw, v.Y / dh)
		if scale then scale.Scale = f end
		root.Size = UDim2.fromOffset(v.X / f, v.Y / f)
		task.wait() -- let AbsoluteSize/TextFits update
		table.insert(report, string.format("== %dx%d (scale %.2f)\n%s", v.X, v.Y, f, PropertySweep.run(root, opts)))
	end
	root.Size = oldSize
	if scale and oldScale then scale.Scale = oldScale end
	return table.concat(report, "\n")
end

return PropertySweep
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Theme: the style tokens in Roblox units (the Luau side of styles/stud.css + style.css).
-- Generated screens get their look from the HTML export; use Theme only for the rare runtime bits
-- that cannot be a template (a tint swap, a highlight colour, a stroke on a billboard). Keep it in
-- sync with the CSS tokens: same names, see STYLE.md "Token table". Values below = the stud preset.
local Theme = {}

local function rgb(hex: string): Color3
	return Color3.fromHex(hex)
end

Theme.ink = rgb("#070a0e")                       -- --ink: every outline
Theme.glass = { color = rgb("#080e16"), transparency = 0.24 } -- --glass rgba(8,14,22,.76) -> 1 - .76
Theme.glassCard = { color = rgb("#080e16"), transparency = 0.20 }
Theme.panel = { stroke = 7, corner = 30 }        -- --panel-bw, --panel-rad (design px; UIStroke scales with UIScale)
Theme.plate = { stroke = 6, corner = 20 }        -- --plate-ow, --plate-rad
Theme.stud = { tile = 112, studsPerTile = 4 }    -- --stud: ImageLabel ScaleType Tile, TileSize = 112 design px
Theme.font = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.ExtraBold)
Theme.font2 = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.SemiBold)
Theme.text = { outline = rgb("#121212"), strokeTitle = 4.5, strokeBody = 3.5, strokeSmall = 2 } -- CSS --sw / 2
Theme.sel = rgb("#fff35a")
Theme.gold = rgb("#ffd23a")

-- colour ramps (CSS .c-*): face gradient top/mid/bottom, lip, outline. Face = UIGradient Rotation 90.
Theme.ramp = {
	blue = { top = rgb("#7adcef"), mid = rgb("#57c6e8"), bot = rgb("#3cc6fb"), lip = rgb("#127aa5"), ol = rgb("#04161d") },
	green = { top = rgb("#80ee5a"), mid = rgb("#4ced41"), bot = rgb("#20f633"), lip = rgb("#0aa31a"), ol = rgb("#031a06") },
	red = { top = rgb("#ef747c"), mid = rgb("#e24b51"), bot = rgb("#f9505a"), lip = rgb("#9c1b1f"), ol = rgb("#1c0204") },
	yellow = { top = rgb("#ffe47a"), mid = rgb("#ffc935"), bot = rgb("#ffbd0a"), lip = rgb("#b87400"), ol = rgb("#241500") },
	purple = { top = rgb("#cf8fff"), mid = rgb("#a95cf2"), bot = rgb("#9b45f7"), lip = rgb("#5c1d9c"), ol = rgb("#14041f") },
	grey = { top = rgb("#c3cad0"), mid = rgb("#9aa2a9"), bot = rgb("#8c959d"), lip = rgb("#4f575e"), ol = rgb("#101316") },
	gold = { top = rgb("#fff07a"), mid = rgb("#ffd23a"), bot = rgb("#ffbf1c"), lip = rgb("#c27a00"), ol = rgb("#2a1700") },
}

function Theme.faceGradient(r: { top: Color3, mid: Color3, bot: Color3 }): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, r.top), ColorSequenceKeypoint.new(0.48, r.mid), ColorSequenceKeypoint.new(1, r.bot),
	})
end

-- button motion (same numbers as the HTML .st-hover / .st-press previews)
Theme.motion = { hoverScale = 1.06, hoverLift = -3, pressScale = 0.92, pressSink = 4, openFrom = 0.4 }

return Theme
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--!strict
-- UIKit: the template-usage contract. Every runtime UI element (toast, confirm, tutorial card,
-- billboard, list row ...) is an approved template designed in HTML and built by Builder into
-- ReplicatedStorage.<TemplatesFolder>. Game code clones and fills; it never builds look with
-- Instance.new. Copy into <luau_out>/UIKit.luau (Builder ships it inside the ScreenGui too).
--
--   local K = require(PlayerGui.<Gui>.UIKit)
--   K.init(gui:GetAttribute("TemplatesFolder"), gui.AssetIds)   -- once (Controller does it)
--   local t = K.template("Toast_info")          -- clone (nil + warn if missing: check BEFORE blocking input)
--   K.set(K.find(t, "Msg1"), "Saved!")          -- sets the label AND its nearest "Msg1Shadow" twin
--   K.icon(K.find(t, "Icon"), "coin")           -- icon slug from AssetIds.icons (+ "IconShadow" twin)
--   K.bar(K.find(t, "Bar"), 0.4)                -- Bar frame with fill child "F"
--   K.scaled(t)                                 -- adds UIScale = K.uiScale() (design px -> screen)
--   t.Parent = K.overlay()                      -- the ONE overlay ScreenGui for runtime UI
--   K.plural("Fisherman", 3) / K.article("egg") / K.wrap2(text, 34) / K.showPair(icon, label, on)
--
-- Contract every template follows (PIPELINE.md "Template contract"):
--   * Frame at (0,0) sized in design px; pressable parts are TextButtons with attribute Button = true
--   * live labels have a data-n name in the HTML; drop shadows are "<Name>Shadow" twins
--   * bars: frame "Bar" (or any name) with a fill child "F"; FullW cached as an attribute
--   * state children (sample buttons, key caps, "current" rings) are stripped with K.strip
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local K = {}
local folderName: string? = nil -- K.init, else the main gui's TemplatesFolder attribute (set by Builder)
local assets: any = nil

function K.init(templatesFolder: string?, assetIds: Instance?)
	folderName = templatesFolder
	if assetIds and assetIds:IsA("ModuleScript") then assets = require(assetIds) :: any end
end

local function folder(): Instance?
	if not folderName then
		for _, g in K.playerGui():GetChildren() do
			local n = g:GetAttribute("TemplatesFolder")
			if typeof(n) == "string" then folderName = n break end
		end
	end
	return if folderName then ReplicatedStorage:FindFirstChild(folderName) else nil
end

local function ids(): any
	if not assets then
		local f = folder()
		local m = f and f:FindFirstChild("AssetIds")
		assets = if m then require(m :: ModuleScript) else { icons = {}, art = {} }
	end
	return assets
end

-- design px -> screen px (same basis as the main ScreenGui's FitScale)
function K.uiScale(designW: number?, designH: number?): number
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	return math.clamp(math.min(vp.X / (designW or 1920), vp.Y / (designH or 1080)), 0.3, 2)
end

function K.template(name: string): GuiObject?
	local f = folder()
	local t = f and f:FindFirstChild(name)
	if not t then
		warn("[UIKit] missing template " .. name .. " (designed in templates.html? rebuilt?)")
		return nil
	end
	return t:Clone() :: GuiObject
end

function K.scaled(g: GuiObject, extra: number?): UIScale
	local s = g:FindFirstChild("KitScale") :: UIScale?
	if not s then
		local ns = Instance.new("UIScale")
		ns.Name = "KitScale"
		ns.Parent = g
		s = ns
	end
	local us = s :: UIScale
	us.Scale = K.uiScale() * (extra or 1)
	return us
end

-- first non-shadow descendant with that name (names come from data-n in the HTML)
function K.find(scope: Instance?, name: string): Instance?
	if not scope then return nil end
	for _, d in scope:GetDescendants() do
		if d.Name == name then return d end
	end
	return nil
end

-- the "<Name>Shadow" twin NEAREST to the label (a parent can hold two Value/ValueShadow pairs;
-- taking the first one found left a stale number drawn under the real one)
function K.twin(g: GuiObject): GuiObject?
	local best, bd = nil, math.huge
	if not g.Parent then return nil end
	for _, c in g.Parent:GetChildren() do
		if c.Name == g.Name .. "Shadow" and c:IsA("GuiObject") then
			local d = math.abs(c.Position.X.Offset - g.Position.X.Offset) + math.abs(c.Position.Y.Offset - g.Position.Y.Offset)
				+ 1000 * (math.abs(c.Position.X.Scale - g.Position.X.Scale) + math.abs(c.Position.Y.Scale - g.Position.Y.Scale))
			if d < bd then best, bd = c, d end
		end
	end
	return best
end

-- live text keeps its design size and only shrinks when the box is too small (floor 14 px: a
-- MinTextSize of 6 came out ~2 px on phones)
-- The cap is re-applied on every set AND when the viewport changes: computed once at join, the viewport
-- can still be ~1x1, uiScale clamps to 0.3 and the label stays ~11 px for the whole session.
local fitted: { TextLabel } = {}
local function applyCap(l: TextLabel)
	local c = l:FindFirstChild("KitFitCap") :: UITextSizeConstraint?
	if not c then
		return
	end
	local design = l:GetAttribute("KitDesignSize") or l.TextSize
	c.MaxTextSize = math.max(8, math.floor(design * K.uiScale())) -- cap is in SCREEN px
	c.MinTextSize = math.min(14, c.MaxTextSize)
end
local function fit(l: TextLabel)
	if l:GetAttribute("KitFit") then
		applyCap(l)
		return
	end
	l:SetAttribute("KitFit", true)
	l:SetAttribute("KitDesignSize", l.TextSize)
	local c = Instance.new("UITextSizeConstraint")
	c.Name = "KitFitCap"
	c.Parent = l
	applyCap(l)
	l.TextScaled = true
	l.TextTruncate = Enum.TextTruncate.AtEnd
	table.insert(fitted, l)
	if #fitted == 1 and workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			for i = #fitted, 1, -1 do
				if fitted[i].Parent then
					applyCap(fitted[i])
				else
					table.remove(fitted, i)
				end
			end
		end)
	end
end

function K.set(label: Instance?, text: any)
	if not (label and label:IsA("TextLabel")) then return end
	local s = tostring(text)
	local sh = K.twin(label)
	if label.Text ~= s then
		fit(label)
		label.Text = s
		if sh and sh:IsA("TextLabel") then
			fit(sh)
			sh.Text = s
		end
	end
end

-- show/hide a label or icon together with its Shadow twin
function K.show(g: Instance?, on: boolean)
	if g and g:IsA("GuiObject") then
		g.Visible = on
		local sh = K.twin(g)
		if sh then sh.Visible = on end
	end
end

-- reward rows: hide icon + number (and twins) when the amount is zero; never show "+0"
function K.showPair(icon: Instance?, label: Instance?, amount: number, fmt: ((number) -> string)?)
	local on = amount > 0
	K.show(icon, on)
	K.show(label, on)
	if on then K.set(label, (fmt or tostring)(amount)) end
end

function K.icon(img: Instance?, slug: string?)
	if not (img and img:IsA("ImageLabel") and slug) then return end
	local id = ids().icons[slug]
	if not id then
		warn("[UIKit] icon not uploaded: " .. slug)
		return
	end
	img.Image = id
	local sh = K.twin(img)
	if sh and sh:IsA("ImageLabel") then sh.Image = id end
end

-- Bar frame with a fill child "F": width = FullW * frac (FullW remembered the first time)
function K.bar(bar: Instance?, frac: number)
	if not bar then return end
	local f = bar:FindFirstChild("F") :: Frame?
	if not f then return end
	local full = f:GetAttribute("FullW") :: number?
	if not full then
		full = (bar :: Frame).Size.X.Offset - 2 * f.Position.X.Offset
		f:SetAttribute("FullW", full)
	end
	frac = math.clamp(frac, 0, 1)
	f.ClipsDescendants = true
	f.Visible = frac > 0.005
	f.Size = UDim2.new(0, math.max(4, (full :: number) * frac), f.Size.Y.Scale, f.Size.Y.Offset)
end

-- a runtime child added next to panel art must draw above it (a clone keeps ZIndex 1 and lands
-- BEHIND the art it was dropped beside under Sibling ZIndexBehavior)
function K.above(child: GuiObject, parent: Instance?)
	local z = 1
	for _, s in (parent or child.Parent :: Instance):GetChildren() do
		if s ~= child and s:IsA("GuiObject") then z = math.max(z, s.ZIndex) end
	end
	child.ZIndex = z + 1
end

-- destroy template-only children (sample buttons, a key cap from another use, a baked "current"
-- ring) right after cloning. Example: K.strip(card, {"KeyCap", "KeyCapShadow", "Sample"})
function K.strip(t: Instance, names: { string })
	for _, n in names do
		for _, d in t:GetDescendants() do
			if d.Name == n then d:Destroy() end
		end
	end
end

-- left edge of a GuiObject regardless of its AnchorPoint (the UI module re-anchors juicy buttons to
-- 0.5,0.5, so Position.X.Offset is the CENTRE for them). Use for "place a clone beside X".
function K.leftOf(g: GuiObject): number
	return g.Position.X.Offset - g.AnchorPoint.X * g.Size.X.Offset
end
function K.placeBeside(clone: GuiObject, src: GuiObject, gap: number)
	clone.AnchorPoint = src.AnchorPoint
	local left = K.leftOf(src) + src.Size.X.Offset + gap
	clone.Position = UDim2.new(src.Position.X.Scale, left + clone.AnchorPoint.X * clone.Size.X.Offset,
		src.Position.Y.Scale, src.Position.Y.Offset)
	K.rest(clone)
end
-- any code that MOVES a juicy button must re-capture its hover rest position, or the first hover
-- tweens it back to where it used to be
function K.rest(b: GuiObject)
	b:SetAttribute("JuiceRest", b.Position)
end

---------------------------------------------------------------- copy helpers
local IRREGULAR = { Man = "Men", man = "men", Child = "Children", Person = "People", Mouse = "Mice", Fish = "Fish", Sheep = "Sheep" }
-- plural("Fisherman", 3) -> "Fishermen"; plural("Sword (Gold)", 2) -> "Swords (Gold)"; plural("Box", 2) -> "Boxes"
function K.plural(name: string, n: number): string
	if n == 1 then return name end
	local head, tail = string.match(name, "^(.-)(%s*%b())$")
	head = head or name
	tail = tail or ""
	for sing, pl in IRREGULAR do
		if string.sub(head, -#sing) == sing then return string.sub(head, 1, -#sing - 1) .. pl .. tail end
	end
	if string.match(head, "[sxz]$") or string.match(head, "[cs]h$") then return head .. "es" .. tail end
	if string.match(head, "[^aeiou]y$") then return string.sub(head, 1, -2) .. "ies" .. tail end
	return head .. "s" .. tail
end
-- article("Infantry Fighting Vehicle") -> "an"
function K.article(word: string): string
	local w = string.lower(word)
	if string.match(w, "^uni") or string.match(w, "^eu") or string.match(w, "^one") then return "a" end
	if string.match(w, "^hour") or string.match(w, "^honest") then return "an" end
	return if string.match(w, "^[aeiou]") then "an" else "a"
end
-- split for two-line templates at a real space (no space: keep every character)
function K.wrap2(text: string, n: number): (string, string?)
	if #text <= n then return text, nil end
	for i = n, 1, -1 do
		if string.sub(text, i, i) == " " then return string.sub(text, 1, i - 1), string.sub(text, i + 1) end
	end
	return string.sub(text, 1, n), string.sub(text, n + 1)
end
-- write EVERY line of a multi-line template ("" for unused) so an old line never lingers
function K.setLines(t: Instance, prefix: string, lines: { string }, max: number)
	for i = 1, max do K.set(K.find(t, prefix .. i), lines[i] or "") end
end

---------------------------------------------------------------- world labels (BillboardGui)
-- Size in studs (shrinks with distance), content clamped to [minPx, maxPx], grows UP from the
-- anchor, hides when the camera is very close. StudsOffset is CAMERA space: +Y lifts on screen,
-- +Z pulls toward the camera (clears flagpoles/avatars in front). For a camera looking down at a
-- building, lift by about half its footprint or the roof's far edge covers the label.
type WL = { bb: BillboardGui, content: GuiObject, cw: number, scale: UIScale, minPx: number, maxPx: number, fadeNear: number? }
local labels: { [BillboardGui]: WL } = {}
local stepping = false
function K.worldLabel(bb: BillboardGui, content: GuiObject, o: { studs: number, minPx: number?, maxPx: number?, fadeNear: number?, lift: number?, toward: number? })
	local cw, ch = content.Size.X.Offset, content.Size.Y.Offset
	bb.Size = UDim2.new(o.studs, 0, o.studs * ch / math.max(1, cw), 0)
	bb.SizeOffset = Vector2.new(0, 0.5)
	bb.StudsOffset = Vector3.new(0, o.lift or 0, o.toward or 0)
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false -- AlwaysOnTop billboards failed to draw in playtests; lift instead
	content.AnchorPoint = Vector2.new(0.5, 1)
	content.Position = UDim2.new(0.5, 0, 1, 0)
	local sc = content:FindFirstChild("FitScale") :: UIScale?
	if not sc then
		local ns = Instance.new("UIScale")
		ns.Name = "FitScale"
		ns.Parent = content
		sc = ns
	end
	labels[bb] = { bb = bb, content = content, cw = cw, scale = sc :: UIScale, minPx = o.minPx or math.min(cw, 70), maxPx = o.maxPx or cw, fadeNear = o.fadeNear }
	if not stepping then
		stepping = true
		RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			for b, L in labels do
				if not b.Parent then labels[b] = nil continue end
				local px = math.clamp(b.AbsoluteSize.X, L.minPx, L.maxPx)
				L.scale.Scale = px / L.cw
				if L.fadeNear and cam then
					local a = b.Adornee
					local p = if a and a:IsA("BasePart") then a.Position elseif a and a:IsA("Model") then a:GetPivot().Position else nil
					if p then L.content.Visible = (cam.CFrame.Position - p).Magnitude > L.fadeNear end
				end
			end
		end)
	end
	-- NOTE: a BillboardGui clips content to its Size even with ClipsDescendants off. If minPx can
	-- exceed the studs size (phones), size the billboard in PIXELS with ~1.5x headroom instead.
end

-- "edit-mode tooling must not save into the place": anything a harness creates while Studio is
-- not running gets Archivable = false
function K.scratch(inst: Instance): Instance
	if not RunService:IsRunning() then inst.Archivable = false end
	return inst
end

-- the ONE overlay ScreenGui for every runtime element (toasts, dialogs, tutorial, touch buttons):
-- above the imported UI, ignores the inset, survives respawn, created on first use.
function K.overlay(): ScreenGui
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local o = pg:FindFirstChild("UIOverlay") :: ScreenGui?
	if not o then
		local g = Instance.new("ScreenGui")
		g.Name = "UIOverlay"
		g.DisplayOrder = 20
		g.IgnoreGuiInset = true
		g.ResetOnSpawn = false
		g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		g.Parent = pg
		o = g
	end
	return o :: ScreenGui
end

function K.playerGui(): PlayerGui
	return Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
end

return K
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">UpdateInPlace</string><ProtectedString name="Source"><![CDATA[--!strict
-- UpdateInPlace: refresh a list of rows without destroying them.
-- A panel that destroyed and re-cloned every row each second dropped any tap whose press and
-- release straddled the refresh (Activated needs both on the same instance), and reset hover/press
-- animations. Rows are now keyed: reused when the key set is unchanged, only labels update.

local UpdateInPlace = {}

export type Item = { key: string, locked: boolean?, [string]: any }

export type List = {
	container: GuiObject,
	template: GuiObject,
	fill: (row: GuiObject, item: Item) -> (),   -- set texts/colours/bars ONLY (no Instance.new)
	wire: (row: GuiObject, item: Item) -> (),   -- connect buttons ONCE per row; read item via row attribute
	rows: { [string]: GuiObject },
	signature: string,
}

function UpdateInPlace.new(container: GuiObject, template: GuiObject, fill, wire): List
	return { container = container, template = template, fill = fill, wire = wire, rows = {}, signature = "" }
end

local function sig(items: { Item }): string
	local parts = table.create(#items)
	for i, it in items do
		parts[i] = it.key .. (if it.locked then "#L" else "")
	end
	return table.concat(parts, "|")
end

function UpdateInPlace.render(list: List, items: { Item })
	local s = sig(items)
	if s ~= list.signature then
		-- the set changed: keep rows whose key survives, add new ones, drop the rest
		local keep = {}
		for i, it in items do
			local row = list.rows[it.key]
			if not row then
				row = list.template:Clone()
				row.Name = "Row_" .. it.key
				row:SetAttribute("Key", it.key)
				list.wire(row, it)
				row.Parent = list.container
			end
			row.LayoutOrder = i
			keep[it.key] = row
		end
		for key, row in list.rows do
			if not keep[key] then row:Destroy() end
		end
		list.rows = keep
		list.signature = s
	end
	-- every refresh: only cheap property writes
	for _, it in items do
		list.fill(list.rows[it.key], it)
	end
end

--[[ Usage
local sell = UpdateInPlace.new(panel.List, templates.SellRow,
	function(row, it)
		(row :: any).ItemName.Text = it.name
		(row :: any).Price.Text = NumberFormat.cash(it.price)
	end,
	function(row, it)
		local key = row:GetAttribute("Key")
		(row :: any).SellButton.Activated:Connect(function() Remotes.Sell:FireServer(key) end)
	end)

-- refresh only while visible, and only when state changes (plus a 1 s tick for timers)
State.changed:Connect(function()
	if panel.Visible then UpdateInPlace.render(sell, buildItems(State.get())) end
end)
]]

return UpdateInPlace
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX4"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX1"><Properties><string name="Name">Controller</string><ProtectedString name="Source"><![CDATA[-- Controller (LocalScript inside the ScreenGui; Builder copies it from the Client folder).
-- Boots the UI module + UIKit and enables the gui. The StarterGui copy stays Enabled = false on
-- purpose so the design-size HUD never covers the Studio edit viewport.
--
-- PREVIEW VALUES are opt-in: they are written ONLY when the ScreenGui has the attribute PreviewMode = true
-- (set it by hand for a UI-only preview place; never in the real game). A controller that always wrote demo
-- numbers raced the game's own client and a fresh save showed "$30,500 / 125 gems".
local gui = script.Parent
local UI = require(gui:WaitForChild("UI"))
local UIKit = require(gui:WaitForChild("UIKit"))
UIKit.init(gui:GetAttribute("TemplatesFolder"), gui:FindFirstChild("AssetIds"))
UI.init(gui)
gui.Enabled = true

if gui:GetAttribute("PreviewMode") == true then
	local NumberFormat = require(gui:WaitForChild("NumberFormat"))
	local hud = gui.Root:FindFirstChild("HUD")
	if hud then
		UI.setText(hud, "CashText", NumberFormat.cash(30500))
		UI.setText(hud, "GemsText", NumberFormat.format(125))
	end
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Toasts</string><ProtectedString name="Source"><![CDATA[--!strict
-- Toasts: short feedback messages. Clones the approved Toast_<kind> templates (templates.html:
-- Toast_info / Toast_good / Toast_error / Toast_cash, each with Icon, Msg1 (+Msg1Shadow) and a
-- countdown bar Time with fill F). Never builds the look here.
-- Dedupes identical text (restart + pulse instead of stacking), picks a duration from length, caps
-- the stack at 4, closes the gap when one leaves, merges bursts, docks while a panel is open.
--
--   local Toasts = require(gui:WaitForChild("Toasts"))   -- lives in luau_out/client/, ships with the gui
--   Toasts.init(UIKit)                                    -- after UIKit.init(...)
--   Toasts.show("Need 950 more coins", { kind = "error", icon = "warning" })
--   Toasts.merged("coins", 25, function(n) return "+" .. NumberFormat.short(n) .. " coins" end, 2)
--   UI.PageChanged:Connect(function(name) Toasts.dock(name ~= nil) end)

local TweenService = game:GetService("TweenService")

local Toasts = {}

local MAX_STACK, MAX_DOCKED = 4, 2
local GAP = 8
local SHORT, LONG, LONG_CHARS = 3.5, 6, 50
local TOP = 120 -- design px from the top (move it under a tutorial card when one shows)

type Entry = { frame: GuiObject, text: string, token: number }
local stack: { Entry } = {}
local container: Frame
local K: any
local docked = false

function Toasts.init(uikit: any)
	K = uikit
	local c = Instance.new("Frame") -- invisible layout container (not a look)
	c.Name = "ToastStack"
	c.BackgroundTransparency = 1
	c.AnchorPoint = Vector2.new(0.5, 0)
	c.Position = UDim2.new(0.5, 0, 0, TOP)
	c.Size = UDim2.fromOffset(640, 480) -- design px; KitScale maps it to the screen
	K.scaled(c)
	c.Parent = K.overlay()
	container = c
end

local function relayout()
	local y, shown = 0, 0
	for i = #stack, 1, -1 do -- newest on top
		local e = stack[i]
		shown += 1
		e.frame.Visible = shown <= (if docked then MAX_DOCKED else MAX_STACK)
		if e.frame.Visible then
			TweenService:Create(e.frame, TweenInfo.new(0.2), { Position = UDim2.fromOffset(0, y) }):Play()
			y += e.frame.Size.Y.Offset + GAP
		end
	end
end

-- while a panel is open, toasts move out of its way: bottom-right corner at 0.6 scale, newest 2
function Toasts.dock(on: boolean)
	docked = on
	K.scaled(container, if on then 0.6 else 1)
	if on then
		container.AnchorPoint = Vector2.new(1, 1)
		container.Position = UDim2.new(1, -24, 1, -10)
	else
		container.AnchorPoint = Vector2.new(0.5, 0)
		container.Position = UDim2.new(0.5, 0, 0, TOP * K.uiScale())
	end
	relayout()
end

local function popScale(f: GuiObject): UIScale
	local s = f:FindFirstChild("PopScale") :: UIScale?
	if not s then
		local n = Instance.new("UIScale")
		n.Name = "PopScale"
		n.Parent = f
		s = n
	end
	return s :: UIScale
end

local function remove(e: Entry)
	local i = table.find(stack, e)
	if not i then return end
	table.remove(stack, i)
	local t = TweenService:Create(popScale(e.frame), TweenInfo.new(0.15), { Scale = 0 })
	t.Completed:Once(function() e.frame:Destroy() end)
	t:Play()
	relayout()
end

local function arm(e: Entry, duration: number)
	e.token += 1
	local my = e.token
	-- restart the countdown strip too, or it shows empty while the toast stays up
	local bar = K.find(e.frame, "Time")
	local strip = (bar and bar:FindFirstChild("F")) :: Frame?
	if strip then
		local full = strip:GetAttribute("FullW") :: number?
		if not full then
			full = strip.Size.X.Offset
			strip:SetAttribute("FullW", full)
		end
		local y = strip.Size.Y
		strip.Size = UDim2.new(0, full :: number, y.Scale, y.Offset)
		TweenService:Create(strip, TweenInfo.new(duration, Enum.EasingStyle.Linear),
			{ Size = UDim2.new(0, 0, y.Scale, y.Offset) }):Play()
	end
	task.delay(duration, function()
		if e.token == my then remove(e) end
	end)
end

export type Opts = { kind: string?, icon: string?, duration: number? }

function Toasts.show(text: string, opts: Opts?)
	local o: Opts = opts or {}
	local duration = o.duration or (if #text > LONG_CHARS then LONG else SHORT)
	for _, e in stack do -- dedupe: same text already up -> pulse and restart its timer
		if e.text == text then
			local s = popScale(e.frame)
			s.Scale = 1.12
			TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			arm(e, duration)
			return
		end
	end
	local f = K.template("Toast_" .. (o.kind or "info")) or K.template("Toast_info")
	if not f then return end
	if #stack >= MAX_STACK then remove(stack[1]) end -- oldest drops
	K.set(K.find(f, "Msg1"), text)
	if o.icon then K.icon(K.find(f, "Icon"), o.icon) end
	f.Parent = container
	local e: Entry = { frame = f, text = text, token = 0 }
	table.insert(stack, e)
	relayout()
	local s = popScale(f)
	s.Scale = 0.6
	TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	arm(e, duration)
end

-- Burst merging for events that fire many times a second: at most one toast per `window` seconds,
-- carrying the running total; whatever arrives inside the window is flushed when it ends.
local merged: { [string]: { total: number, last: number, pending: boolean } } = {}
function Toasts.merged(key: string, amount: number, fmt: (number) -> string, window: number)
	local m = merged[key] or { total = 0, last = -math.huge, pending = false }
	merged[key] = m
	m.total += amount
	if os.clock() - m.last >= window then
		m.last = os.clock()
		Toasts.show(fmt(m.total))
		m.total = 0
	elseif not m.pending then
		m.pending = true
		task.delay(window - (os.clock() - m.last), function()
			m.pending = false
			if m.total ~= 0 then
				m.last = os.clock()
				Toasts.show(fmt(m.total))
				m.total = 0
			end
		end)
	end
end

return Toasts
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!strict
-- UI: the runtime module for the imported ScreenGui (skeleton; extend per game, keep the rules).
-- Lives in <luau_out>/client/UI.luau; Builder copies it into StarterGui.<Gui> (Client folder).
-- ONE source of truth: edit the file on disk, re-bundle, and run scripts/check_copies.py.
--
-- From any LocalScript:
--   local UI = require(Players.LocalPlayer.PlayerGui:WaitForChild("EOSUI"):WaitForChild("UI"))
--   UI.open("Shop") / UI.close() / UI.toggle("Shop") / UI.back()   -- close returns to the previous screen
--   UI.current() -> name?   UI.anyOpen() -> bool  (world click handlers: `if UI.anyOpen() then return end`)
--   UI.setText(scope, "CashText", "1,250")                         -- also updates CashTextShadow
--   UI.countTo("cash", 1250, scope, "CashText", NumberFormat.cash)  -- count-up tween, one per key
--   UI.setGroupHidden("Goal", true)                                 -- hide a HUD group (e.g. under a modal)
--   UI.popup(function() ... end, "offer")                           -- queued, suppressed while busy
--   UI.suppress("tutorial", true)                                   -- no unsolicited popups while set
--   UI.Action:Connect(function(name, screen, button) end)           -- every button press
--   UI.PageChanged:Connect(function(name?) end)                     -- screen opened (name) / closed (nil)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")

local UI = {}

local actionEvent = Instance.new("BindableEvent")
UI.Action = actionEvent.Event
local pageEvent = Instance.new("BindableEvent")
UI.PageChanged = pageEvent.Event

local gui: ScreenGui
local root: Frame
local dim: Frame
local screens: { [string]: Frame } = {}
local current: string? = nil
local history: { string } = {}
local inited = false
local conns: { RBXScriptConnection } = {}
local function keep(c: RBXScriptConnection) table.insert(conns, c) end

local OPEN = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CLOSE = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In)
local FADE = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local HOVER = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS = TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SPRING = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

-- HUD groups that stay visible while a panel is open (everything else on HUD screens hides)
UI.keepWithPanel = { Currencies = true }

---------------------------------------------------------------- sounds
-- Fill with audio the game's owner can use (probe first: audio from another creator plays as
-- silence with no error). Engine built-ins under rbxasset://sounds/ also work for prototypes.
local SOUND_IDS: { [string]: string } = {
	hover = "", -- e.g. "rbxassetid://<your hover tick>"
	click = "",
	purchase = "",
	reward = "",
}
local SFX: { [string]: Sound } = {}
local function makeSounds()
	for name, id in SOUND_IDS do
		if id ~= "" then
			local s = Instance.new("Sound")
			s.Name = "UISfx_" .. name
			s.SoundId = id
			s.Volume = if name == "hover" then 0.35 else 0.6
			-- edit-mode harness runs must not save these into the place
			if not RunService:IsRunning() then s.Archivable = false end
			s.Parent = SoundService
			SFX[name] = s
		end
	end
end
function UI.play(name: string)
	local s = SFX[name]
	if s then SoundService:PlayLocalSound(s) end
end

---------------------------------------------------------------- text
local function fitLabel(d: TextLabel)
	-- the cap is in SCREEN px: design size x the CURRENT FitScale (else text shrinks above 1080p). Re-applied on
	-- every set: FitScale can still be tiny when the first text arrives at join, freezing the label at ~11 px.
	local c = d:FindFirstChild("UIFitCap") :: UITextSizeConstraint?
	if not c then
		d:SetAttribute("UIFit", true)
		d:SetAttribute("UIDesignSize", d.TextSize)
		c = Instance.new("UITextSizeConstraint")
		c.Name = "UIFitCap"
		c.Parent = d
		d.TextScaled = true
	end
	local fs = root and root:FindFirstChild("FitScale") :: UIScale?
	local design = d:GetAttribute("UIDesignSize") or d.TextSize
	c.MaxTextSize = math.max(8, math.floor(design * (if fs then fs.Scale else 1)))
	c.MinTextSize = math.min(14, c.MaxTextSize)
end
-- set a named label and EVERY "<name>Shadow" twin under scope (the drop shadow is a second label)
function UI.setText(scope: Instance, name: string, text: string)
	for _, d in scope:GetDescendants() do
		if d:IsA("TextLabel") and (d.Name == name or d.Name == name .. "Shadow") then
			fitLabel(d)
			d.Text = text
		end
	end
end

-- count-up: one tween per key; a new value cancels the old tween and the label always lands on
-- the exact target (overlapping tweens fought and the slower one left a stale number)
local shown: { [string]: number } = {}
local running: { [string]: Tween } = {}
function UI.countTo(key: string, target: number, scope: Instance, label: string, fmt: (number) -> string)
	local prev = running[key]
	if prev then prev:Cancel() end
	local nv = Instance.new("NumberValue")
	nv.Value = shown[key] or target
	nv.Changed:Connect(function(v) UI.setText(scope, label, fmt(v)) end)
	local t = TweenService:Create(nv, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { Value = target })
	running[key] = t
	t.Completed:Once(function(state)
		if running[key] == t then running[key] = nil end
		if state ~= Enum.PlaybackState.Cancelled then UI.setText(scope, label, fmt(target)) end
		nv:Destroy()
	end)
	t:Play()
	shown[key] = target
end

---------------------------------------------------------------- screens
local function popIn(frame: GuiObject)
	for _, g in frame:GetChildren() do
		if g:IsA("GuiObject") then
			local s = g:FindFirstChild("PopScale") :: UIScale?
			if not s then
				local ns = Instance.new("UIScale")
				ns.Name = "PopScale"
				ns.Parent = g
				s = ns
			end
			local ps = s :: UIScale
			ps.Scale = 0.4
			TweenService:Create(ps, OPEN, { Scale = 1 }):Play()
		end
	end
end
local function popOut(frame: GuiObject, done: () -> ())
	local last: Tween? = nil
	for _, g in frame:GetChildren() do
		local s = g:FindFirstChild("PopScale") :: UIScale?
		if s then
			local t = TweenService:Create(s, CLOSE, { Scale = 0 })
			t:Play()
			last = t
		end
	end
	if last then last.Completed:Once(done) else done() end
end
local function setDim(alpha: number)
	if alpha > 0 then
		dim.Visible = true
		TweenService:Create(dim, FADE, { BackgroundTransparency = 1 - alpha }):Play()
	else
		local t = TweenService:Create(dim, FADE, { BackgroundTransparency = 1 })
		t.Completed:Once(function()
			if dim.BackgroundTransparency >= 0.99 then dim.Visible = false end
		end)
		t:Play()
	end
end

local hiddenGroups: { [string]: boolean } = {}
function UI.setGroupHidden(name: string, on: boolean)
	hiddenGroups[name] = on or nil
	UI.refreshHud()
end
function UI.refreshHud()
	for _, s in screens do
		if s:GetAttribute("Hud") then
			for _, g in s:GetChildren() do
				if g:IsA("GuiObject") then
					g.Visible = not hiddenGroups[g.Name] and (current == nil or UI.keepWithPanel[g.Name] == true)
				end
			end
		end
	end
end

function UI.current(): string?
	return current
end
function UI.isOpen(name: string): boolean
	return current == name
end
function UI.anyOpen(): boolean
	return current ~= nil
end

function UI.open(name: string, opts: { keepHistory: boolean? }?)
	local s = screens[name]
	assert(s, "no screen " .. name)
	if current == name then return end
	if current then
		if opts and opts.keepHistory then table.insert(history, current) end
		screens[current].Visible = false
	end
	current = name
	s.Visible = true
	popIn(s)
	setDim((s:GetAttribute("Dim") :: number?) or 0)
	UI.refreshHud()
	pageEvent:Fire(name)
end

-- every close path (X button, Escape, gamepad B, scrim, code) goes through here
function UI.close()
	local name = current
	if not name then return end
	current = nil
	local s = screens[name]
	popOut(s, function()
		if current ~= name then s.Visible = false end
	end)
	local back = table.remove(history)
	if back then
		UI.open(back) -- return to the screen the player came from
		return
	end
	setDim(0)
	UI.refreshHud()
	pageEvent:Fire(nil)
end
function UI.toggle(name: string)
	if current == name then UI.close() else UI.open(name) end
end
function UI.back()
	UI.close()
end

---------------------------------------------------------------- buttons
local function centreAnchor(b: GuiObject)
	if b.AnchorPoint == Vector2.new(0.5, 0.5) then return end
	local p, s = b.Position, b.Size
	b.Position = p + UDim2.new(s.X.Scale * (0.5 - b.AnchorPoint.X), s.X.Offset * (0.5 - b.AnchorPoint.X),
		s.Y.Scale * (0.5 - b.AnchorPoint.Y), s.Y.Offset * (0.5 - b.AnchorPoint.Y))
	b.AnchorPoint = Vector2.new(0.5, 0.5)
end
local function screenOf(b: Instance): string
	local p: Instance? = b
	while p and p.Parent ~= root do p = p.Parent end
	return if p then p.Name else "?"
end

-- hover grow + lift + sound, press sink, release spring. Rest position lives in the JuiceRest
-- attribute: code that moves a button must update it (UIKit.rest) or hover snaps it back.
local wired: { [GuiButton]: boolean } = setmetatable({}, { __mode = "k" }) :: any
function UI.juicy(b: GuiButton)
	-- tracked per INSTANCE (not an attribute): a clone of a juiced prototype copies attributes and the
	-- JuiceScale child but none of the connections, and must be wired again
	if wired[b] then return end
	wired[b] = true
	local stale = b:FindFirstChild("JuiceScale")
	if stale then stale:Destroy() end
	centreAnchor(b)
	b:SetAttribute("JuiceRest", b.Position)
	local sc = Instance.new("UIScale")
	sc.Name = "JuiceScale"
	sc.Parent = b
	local hovered, held = false, false
	local lift = if b.Name == "CloseButton" then 1.12 else 1.06
	local function to(info: TweenInfo, s: number, dy: number)
		TweenService:Create(sc, info, { Scale = s }):Play()
		local at = (b:GetAttribute("JuiceRest") :: UDim2?) or b.Position
		TweenService:Create(b, info, { Position = at + UDim2.fromOffset(0, dy) }):Play()
	end
	b.MouseEnter:Connect(function()
		hovered = true
		if not held then
			UI.play("hover")
			to(HOVER, lift, -3)
		end
	end)
	b.MouseLeave:Connect(function()
		hovered, held = false, false
		to(HOVER, 1, 0)
	end)
	b.MouseButton1Down:Connect(function()
		held = true
		to(PRESS, 0.92, 4)
	end)
	b.MouseButton1Up:Connect(function()
		if not held then return end
		held = false
		to(SPRING, if hovered then lift else 1, if hovered then -3 else 0)
	end)
	b.Activated:Connect(function()
		UI.play("click")
		local opens = b:GetAttribute("Opens") :: string?
		if b.Name == "CloseButton" then
			actionEvent:Fire("CloseButton", screenOf(b), b) -- listeners run first (e.g. "collect on close")
			UI.close()
			return
		elseif opens and screens[opens] then
			UI.toggle(opens)
		end
		actionEvent:Fire(b.Name, screenOf(b), b)
	end)
end

---------------------------------------------------------------- popups (unsolicited offers, celebrations)
-- Queue so two never overlap. Earned celebrations ("reward") always queue and show after the current
-- one (they are not held back by suppress(); call them when the moment is right). Unsolicited offers
-- ("offer") are DROPPED while suppressed / a panel is open / too soon after join or the last offer.
local suppressed: { [string]: boolean } = {}
local queue: { () -> () } = {}
local busy = false
local lastOffer, joinedAt = -math.huge, os.clock()
UI.offerCooldown, UI.offerGraceAfterJoin = 180, 90
function UI.suppress(reason: string, on: boolean)
	suppressed[reason] = on or nil
end
local function blocked(): boolean
	return next(suppressed) ~= nil or current ~= nil
end
function UI.popupDone()
	busy = false
	local nxt = table.remove(queue, 1)
	if nxt then
		busy = true
		task.defer(nxt)
	end
end
-- kind "reward": always shown eventually (queued). kind "offer": dropped if blocked/too soon.
-- fn must call UI.popupDone() when its popup closes (also on failure paths).
function UI.popup(fn: () -> (), kind: string?)
	if kind == "offer" then
		if blocked() or busy or os.clock() - joinedAt < UI.offerGraceAfterJoin or os.clock() - lastOffer < UI.offerCooldown then return end
		lastOffer = os.clock()
	end
	if busy then
		table.insert(queue, fn)
		return
	end
	busy = true
	task.defer(fn)
end

---------------------------------------------------------------- fit to screen
local function fit()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	if vp.X < 2 or vp.Y < 2 then return end
	local W, H = root:GetAttribute("DesignW") :: number, root:GetAttribute("DesignH") :: number
	local s = math.min(vp.X / W, vp.Y / H)
	root.Size = UDim2.fromOffset(vp.X / s, vp.Y / s)
	local fs = root:FindFirstChild("FitScale") :: UIScale
	fs.Scale = s
	-- Roblox's top bar keeps its point size while the HUD scales down (phones): push top-corner
	-- groups below it. Their design offset is remembered in BaseY.
	local inset = GuiService.TopbarInset
	local barH = if inset.Max.Y > 0 then inset.Max.Y / s + 8 else 0
	local rw = vp.X / s
	local leftEnd, rightStart = inset.Min.X / s, (if inset.Max.X > 0 then inset.Max.X else vp.X) / s
	for _, sc in screens do
		for _, g in sc:GetChildren() do
			if g:IsA("GuiObject") and g.Position.Y.Scale == 0 then
				local base = g:GetAttribute("BaseY") :: number?
				if base == nil then
					base = g.Position.Y.Offset
					g:SetAttribute("BaseY", base)
				end
				local x0 = g.Position.X.Scale * rw + g.Position.X.Offset - g.AnchorPoint.X * g.Size.X.Offset
				local x1 = x0 + g.Size.X.Offset
				local inCorner = x0 < leftEnd or x1 > rightStart
				local y = base :: number
				if inCorner and y < barH then y = barH end
				g.Position = UDim2.new(g.Position.X.Scale, g.Position.X.Offset, 0, y)
			end
		end
	end
end

---------------------------------------------------------------- init
function UI.init(g: ScreenGui?): typeof(UI)
	if inited then return UI end
	inited = true
	gui = g or Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("EOSUI") :: ScreenGui
	root = gui:WaitForChild("Root") :: Frame
	dim = root:WaitForChild("Dim") :: Frame
	if not root:GetAttribute("DesignW") then
		root:SetAttribute("DesignW", root.Size.X.Offset)
		root:SetAttribute("DesignH", root.Size.Y.Offset)
	end
	for _, s in root:GetChildren() do
		if s:IsA("Frame") and s.Name ~= "Dim" then screens[s.Name] = s end
	end
	makeSounds()
	for _, d in root:GetDescendants() do
		if d:IsA("GuiButton") and d:GetAttribute("Button") then UI.juicy(d) end
	end
	keep(dim.InputBegan:Connect(function(input)
		-- tapping the scrim closes the panel (and never reaches the world)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if current then actionEvent:Fire("CloseButton", current, nil); UI.close() end
		end
	end))
	UI.refreshHud()
	fit()
	local function hook()
		local cam = workspace.CurrentCamera
		if cam then keep(cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)) end
		fit()
	end
	keep(GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(fit))
	keep(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook))
	hook()
	keep(UserInputService.InputBegan:Connect(function(input, processed)
		-- Escape is bound to the Roblox menu: it can arrive with processed = true, so check it BEFORE
		-- the processed early-return (but never while the player is typing in a TextBox)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if current and not UserInputService:GetFocusedTextBox() then
				actionEvent:Fire("CloseButton", current, nil)
				UI.close()
			end
			return
		end
		if processed then return end
		-- game hotkeys go here; respect modes (no hotbar keys while a panel/battle owns the screen)
	end))
	keep(GuiService.MenuOpened:Connect(function()
		if current then UI.close() end
	end))
	return UI
end

-- disconnect everything init() hooked (used by the edit-mode harness before destroying its clone)
function UI.destroy()
	for _, c in conns do c:Disconnect() end
	table.clear(conns)
	for _, s in SFX do s:Destroy() end
	table.clear(SFX)
	inited = false
end

return UI
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
