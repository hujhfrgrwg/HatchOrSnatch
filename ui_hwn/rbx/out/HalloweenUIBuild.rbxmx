RAGON","font":"FredokaOne","wt":700,"xa":"C","n":"TitleShadow","w":472.03,"h":48.6,"ts":48.6,"tc":[5,5,6],"stroke":{"t":4.68,"c":[5,5,6],"join":"Round","mode":"Contextual"},"x":13.97,"y":369.1,"attrs":{"FitW":277.73}},{"c":"TextLabel","txt":"BONE DRAGON","font":"FredokaOne","wt":700,"xa":"C","n":"Title","w":472.03,"h":48.6,"ts":48.6,"tc":[255,255,255],"stroke":{"t":4.68,"c":[5,5,6],"join":"Round","mode":"Contextual"},"grad":{"rot":90,"c":[[0,255,255,255],[0.0679,255,255,255],[0.9321,255,255,255],[1,255,255,255]]},"x":13.97,"y":363.7,"attrs":{"FitW":277.73}},{"c":"ImageLabel","n":"I_ab_tempestShadow","w":34,"h":34,"img":"icon:ab_tempest","ic":[0,0,0],"it":0.65,"st":"Fit","x":180.09,"y":424},{"c":"ImageLabel","n":"I_ab_tempest","w":34,"h":34,"img":"icon:ab_tempest","st":"Fit","x":180.09,"y":421},{"c":"TextLabel","txt":"TEMPEST","font":"FredokaOne","wt":700,"xa":"L","n":"FamilyShadow","w":261.91,"h":26.73,"ts":26.73,"tc":[5,5,6],"stroke":{"t":1.95,"c":[5,5,6],"join":"Round","mode":"Contextual"},"x":222.09,"y":426.43,"attrs":{"FitW":97.81}},{"c":"TextLabel","txt":"TEMPEST","font":"FredokaOne","wt":700,"xa":"L","n":"Family","w":261.91,"h":26.73,"ts":26.73,"tc":[255,255,255],"stroke":{"t":1.95,"c":[5,5,6],"join":"Round","mode":"Contextual"},"grad":{"rot":90,"c":[[0,255,210,58],[0.0679,255,210,58],[0.9321,255,210,58],[1,255,210,58]]},"x":222.09,"y":424.63,"attrs":{"FitW":97.81}},{"c":"TextLabel","txt":"Bone shards blast, soul fire storms.","font":"FredokaOne","wt":700,"xa":"C","n":"TaglineShadow","w":471.99,"h":21.87,"ts":21.87,"tc":[5,5,6],"stroke":{"t":1.56,"c":[5,5,6],"join":"Round","mode":"Contextual"},"x":14.01,"y":461.31,"attrs":{"FitW":291.19}},{"c":"TextLabel","txt":"Bone shards blast, soul fire storms.","font":"FredokaOne","wt":700,"xa":"C","n":"Tagline","w":471.99,"h":21.87,"ts":21.87,"tc":[255,255,255],"stroke":{"t":1.56,"c":[5,5,6],"join":"Round","mode":"Contextual"},"grad":{"rot":90,"c":[[0,210,210,216],[0.0679,210,210,216],[0.9321,210,210,216],[1,210,210,216]]},"x":14.01,"y":459.51,"attrs":{"FitW":291.19}},{"c":"TextButton","n":"BtnRobux","w":450,"h":76,"k":[{"c":"ImageLabel","n":"Art","w":450,"h":80,"img":"art:ae3b3ecb45c","st":"Stretch","x":0,"y":0},{"c":"ImageLabel","n":"I_robuxShadow","w":46,"h":46,"img":"icon:robux","ic":[0,0,0],"it":0.65,"st":"Fit","x":169.38,"y":16.5},{"c":"ImageLabel","n":"I_robux","w":46,"h":46,"img":"icon:robux","st":"Fit","x":169.38,"y":13.5},{"c":"TextLabel","txt":"399","font":"FredokaOne","wt":700,"xa":"L","n":"RobuxPriceShadow","w":214.62,"h":41.31,"ts":41.31,"tc":[5,5,6],"stroke":{"t":1.95,"c":[5,5,6],"join":"Round","mode":"Contextual"},"x":225.38,"y":17.64,"attrs":{"FitW":55.25}},{"c":"TextLabel","txt":"399","font":"FredokaOne","wt":700,"xa":"L","n":"RobuxPrice","w":214.62,"h":41.31,"ts":41.31,"tc":[255,255,255],"stroke":{"t":1.95,"c":[5,5,6],"join":"Round","mode":"Contextual"},"grad":{"rot":90,"c":[[0,255,255,255],[0.0679,255,255,255],[0.9321,255,255,255],[1,255,255,255]]},"x":225.38,"y":15.85,"attrs":{"FitW":55.25}}],"attrs":{"Button":true},"x":25,"y":497},{"c":"TextButton","n":"BtnOwned","w":450,"h":76,"k":[{"c":"ImageLabel","n":"Art","w":450,"h":80,"img":"art:ad4f88e5737","st":"Stretch","x":0,"y":0},{"c":"ImageLabel","n":"I_checkShadow","w":42,"h":42,"img":"icon:check","ic":[0,0,0],"it":0.65,"st":"Fit","x":140.95,"y":18.5},{"c":"ImageLabel","n":"I_check","w":42,"h":42,"img":"icon:check","st":"Fit","x":140.95,"y":15.5},{"c":"TextLabel","txt":"OWNED","font":"FredokaOne","wt":700,"xa":"L","n":"LabelShadow","w":247.05,"h":38.88,"ts":38.88,"tc":[5,5,6],"stroke":{"t":1.95,"c":[5,5,6],"join":"Round","mode":"Contextual"},"x":192.95,"y":18.86,"attrs":{"FitW":116.08}},{"c":"TextLabel","txt":"OWNED","font":"FredokaOne","wt":700,"xa":"L","n":"Label","w":247.05,"h":38.88,"ts":38.88,"tc":[255,255,255],"stroke":{"t":1.95,"c":[5,5,6],"join":"Round","mode":"Contextual"},"grad":{"rot":90,"c":[[0,255,255,255],[0.0679,255,255,255],[0.9321,255,255,255],[1,255,255,255]]},"x":192.95,"y":17.06,"attrs":{"Fit